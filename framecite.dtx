% \title{The \textsf{framecite} package}
% \author{Tobias J. Bauer \\ \texttt{https://github.com/Hirnmoder/framecite}}
% \date{Version 0.8, released 2026/11/20}
%
% \maketitle
%
% \begin{abstract}
% \textsf{framecite} shows the sources cited on a beamer slide as a
% small block at the bottom of that same slide. Each entry renders the
% citation label, the author or editor, and the quoted title. The block
% sits between real \LaTeX{} footnotes and the theme footline. It is
% populated automatically from ordinary citation commands and can be
% extended manually.
% \end{abstract}
%
% \tableofcontents
%
% \section{Introduction}
%
% Short-form citations such as \texttt{[2]} keep slide text readable, but
% the audience can no longer see where a claim comes from. This package
% restores that link: on every frame where a citation appears, the source
% itself is listed at the bottom of that frame. Each entry has the form
% \begin{quote}
%   \texttt{<label> <author>: \string\mkbibquote\{<title>\}}
% \end{quote}
% where \emph{label} is whatever the active biblatex style prints
% (\texttt{[2]} for \texttt{numeric}, \texttt{[XYZ+23]} for \texttt{alphabetic}), and
% \emph{title} is the \texttt{shorttitle} field if present, else the \texttt{title}
% field. Entries for one frame appear in order of first citation, and a
% work cited more than once on a frame is listed only once.
%
% The source block is written into beamer's footnote insert at frame
% end, above the theme footline and below any real footnotes. It uses a
% blank footnote mark and its own beamer font/color element, so it reads
% as a separate `sources' block and never disturbs the theme.
%
% Bugs and feature requests can be reported in the package repository at
% \texttt{https://github.com/Hirnmoder/framecite/issues}.
%
% \section{Requirements and loading}
%
% The package requires the \LaTeX{} \textsf{beamer} class; load
% \textsf{framecite} only in a beamer document. It further requires
% \textsf{biblatex}, which must be loaded \emph{before}
% \textsf{framecite} (the wrapping of the cite commands depends on it).
% \textsf{etoolbox} and \textsf{xspace} are loaded automatically. Titles
% in the source block are wrapped in biblatex's
% \texttt{\string\mkbibquote}, so the quotation marks follow your setup:
% if you load \textsf{csquotes} --- with any options, anywhere in the
% preamble --- they come from its \texttt{\string\enquote}; otherwise
% biblatex's quotation fallback applies, as for entry titles in the
% bibliography. A minimal preamble:
% \begin{verbatim}
% \documentclass{beamer}
% \usepackage[backend=biber, style=numeric]{biblatex}
% \addbibresource{references.bib}
% \usepackage{framecite}
% \end{verbatim}
% Both requirements are enforced: loading without beamer or before
% biblatex terminates with a package error that names the fix.
%
% \section{Package options}
%
% \begin{itemize}
%   \item \texttt{patchcite} (default) intercepts the short-form cite
%     commands so that their keys feed the per-frame source list.
%     \texttt{nopatchcite} leaves those commands untouched; register
%     sources manually with \texttt{\string\fcite} or
%     \texttt{\string\fsource} instead.
%   \item \texttt{label=margin} (default) places the cite label in the
%     left margin, so the title (and its continuation lines) stays flush
%     at the left edge, like a normal footnote. \texttt{label=inline}
%     sets label and title in one flow: the entry starts with the label.
%     In \texttt{margin} mode the label juts into the gutter with its
%     natural width.
%   \item \texttt{rule=auto/always/never} (default \texttt{auto}) controls
%     the rule above the footnote region. \texttt{auto} draws the rule
%     only when a real \texttt{\string\footnote} was called on the frame;
%     source lines do not count. \texttt{always} draws it whenever any
%     footnote content is present (beamer's default). \texttt{never}
%     suppresses it entirely.
% \end{itemize}
%
% \section{Automatic collection}
%
% With \texttt{patchcite} (the default) the short-form commands that
% print a citation label are intercepted: \texttt{\string\cite},
% \texttt{\string\parencite}, and \texttt{\string\textcite}. Their
% optional \texttt{[pre][post]} arguments are forwarded untouched. All
% entries of a multi-key cite are listed separately; repeated cites of
% one key on a frame are listed once.
%
% Starred variants are captured as well: the star is parsed and forwarded
% to the original command, so \texttt{\string\cite*\{key\}} still feeds
% the frame list.
%
% Four families stay unordered \emph{on purpose}:
% \begin{itemize}
%   \item the field extractors \texttt{\string\citeauthor},
%     \texttt{\string\citeyear}, and \texttt{\string\citetitle} print
%     only the name, the year, or the title --- no citation label --- so
%     the block has no marker on the slide to explain. Register such
%     keys with \texttt{\string\fsource} if you want the source line
%     anyway.
%   \item \texttt{\string\footcite} and \texttt{\string\footcitetext}
%     already place the full citation into the footnote; an additional
%     source line would just duplicate it. Use
%     \texttt{\string\fsource\{key\}} if you want the key in the frame
%     list anyway.
%   \item \texttt{\string\fullcite} and \texttt{\string\footfullcite}
%     already show the full entry on the slide.
%   \item the multi-set commands \texttt{\string\cites},
%     \texttt{\string\textcites}, \dots{} and the invisible
%     \texttt{\string\nocite} are not captured.
% \end{itemize}
%
% \DescribeMacro{\ocite}
% Independently of \texttt{patchcite}, the untouched original cite
% command is always available as \texttt{\string\ocite}: it takes the
% same arguments as \texttt{\string\cite} --- star, pre-/postnote, key
% lists --- prints the style label, and never feeds the per-frame
% source list. Use it where a source line would only repeat what the
% slide already shows, and in frame titles, section titles, and other
% headings: beamer expands these late and theme-dependently, so a
% patched cite there can miss its frame or leak into the next one.
%
% \DescribeMacro{\oparencite}
% \DescribeMacro{\otextcite}
% \texttt{\string\oparencite} and \texttt{\string\otextcite} are the
% matching originals of the other two wrappable commands, with the
% same rules.
%
% \section{Manual registration}
%
% \DescribeMacro{\fcite}
% \texttt{\string\fcite} feeds the per-frame source list and prints the
% style-correct label in the text, like an ordinary citation:
% \begin{quote}
%   \texttt{\string\fcite[pre]\{key\}[post]}
% \end{quote}
% The optional \emph{pre} and \emph{post} texts are shown in the footer
% line only: \emph{pre} before the label, \emph{post} after the title.
% They are intended for page numbers or remarks (`see', `ch.~3'). Use
% \texttt{\string\fcite} when \texttt{patchcite} is off, or to attach
% extra information to a source line.
%
% \DescribeMacro{\fsource}
% \texttt{\string\fsource} is the \emph{blind} variant. It registers the
% key (and optional \emph{pre}/\emph{post} texts) exactly like
% \texttt{\string\fcite}, but typesets nothing in the text. It is safe
% between words: no spurious space remains. Use it for implicit
% references (images, background claims) where a visible label would
% distract.
%
% Both commands accept the same starred form. Unstarred calls insert an
% \texttt{\string\xspace} after \emph{pre} and before \emph{post}
% automatically; the starred \texttt{\string\fcite*}/\texttt{\string\fsource*}
% stores the texts verbatim, so you control the spacing exactly. A
% missing optional argument is treated as empty. If a key is registered
% more than once on a frame, the list keeps one entry; the last call
% determines its \emph{pre}/\emph{post} texts.
%
% \section{Layout and styling}
%
% The bottom of a frame is stacked, top to bottom: slide body, real
% \texttt{\string\footnote} region (drawn by the theme), the framecite
% source block, then the theme footline. The source block occupies its
% own vertical space (like a real footnote region, it reduces the slide
% body height), so it never overlaps content and never gets clipped.
% Real footnotes always stay above the source lines.
%
% Each entry prints as \texttt{<label> <names>:~\string\mkbibquote\{<title>\}}.
% The names are the author as biblatex prints them; if the entry has no
% author, the editor is named instead; an entry with neither prints the
% bare quoted title (never a stray colon).
%
% The block is styled through the beamer element \texttt{framecite};
% override it as usual:
% \begin{quote}
%   \texttt{\string\setbeamerfont\{framecite\}\{size=\string\tiny\}}\\
%   \texttt{\string\setbeamercolor\{framecite\}\{fg=normal text.fg!70\}}
% \end{quote}
% The defaults set \texttt{size=\string\tiny} and
% \texttt{fg=normal text.fg!70}. Entries in the block render with tight
% line spacing; the blank footnote mark leaves the visual room to the
% label, which the entry itself repeats in the style of the running
% bibliography.
%
% \section{Overlay behavior}
%
% A frame with overlays is typeset once per slide. All collection state
% is global, so each slide shows the source block exactly once. What is
% listed follows where the cite command \emph{executes}, not where it
% becomes visible: uncover-style hiding (\texttt{\string\pause},
% \texttt{\string\onslide}, \texttt{\string\visible}, \texttt{<n>} item
% specifications) still typesets in every pass, so such sources are
% listed from the first slide. \texttt{\string\only}-gated cites execute
% on their slides only and are listed from there onward.
%
% \section{A complete example}
%
% The demo file \textsf{framecite\_demo.tex} is generated from this
% source by \texttt{framecite.ins}, so the listing below and the
% generated file cannot drift apart. It is fully self-contained:
% the \texttt{.bib} data is embedded via \texttt{filecontents}. Build
% it with \texttt{latexmk -pdf} (or \texttt{pdflatex}, \texttt{biber},
% \texttt{pdflatex}, \texttt{pdflatex}) in a directory that contains
% \textsf{framecite.sty}, e.g.\ the one generated by \texttt{framecite.ins}.
%    \begin{macrocode}
%<*demo>
% framecite: per-frame mini references. Load AFTER biblatex.
\documentclass[aspectratio=169, 10pt]{beamer}

\usetheme[progressbar=frametitle, numbering=fraction]{metropolis}

\usepackage[backend=biber, style=numeric, sortcites]{biblatex}
% To see alphabetic labels like [Knu84] instead, switch to:
%   \usepackage[backend=biber, style=alphabetic]{biblatex}

\begin{filecontents*}[overwrite]{\jobname.bib}
@article{knuth1984,
  author    = {Donald E. Knuth},
  title     = {Literate Programming},
  shorttitle= {Literate Programming},
  journal   = {The Computer Journal},
  volume    = {27},
  number    = {2},
  pages     = {97--111},
  year      = {1984},
}
@book{lamport1994,
  author    = {Leslie Lamport},
  title     = {{LaTeX: A Document Preparation System}},
  shorttitle= {{LaTeX}},
  publisher = {Addison-Wesley},
  year      = {1994},
}
@inproceedings{mittelbach2004,
  author    = {Frank Mittelbach and Michel Goossens and Johannes Braams
               and David Carlisle and Chris Rowley},
  title     = {The {\LaTeX} Companion},
  shorttitle= {{LaTeX} Companion},
  publisher = {Addison-Wesley},
  year      = {2004},
}
@proceedings{nips2017,
  editor    = {Isabelle Guyon and Ulrike von Luxburg and Samy Bengio
               and Hanna Wallach and Rob Fergus and S. V. N. Vishwanathan
               and Roman Garnett},
  title     = {Advances in Neural Information Processing Systems 30},
  shorttitle= {NeurIPS 30},
  publisher = {Curran Associates},
  year      = {2017},
}
\end{filecontents*}
\addbibresource{\jobname.bib}

\usepackage[rule=auto, label=margin]{framecite}

\title{framecite}
\subtitle{Per-frame mini references for beamer + biblatex}
\author{Tobias J. Bauer}
\date{v0.8 (2026-11-20)}

\begin{document}

\begin{frame}
  \titlepage
\end{frame}

\begin{frame}{The idea}
  Short-form citations stay readable in the text, but the audience still
  sees the source on the very slide: the literate-programming idea goes
  back to~\cite{knuth1984}, and the standard reference
  is~\cite{lamport1994}. \pause

  \medskip
  Each cited work appears once below, in first-citation order --- even if
  you cite it repeatedly~\cite{knuth1984,knuth1984}.
\end{frame}

\begin{frame}{Automatic collection}
  With \texttt{patchcite} (the default) the short-form commands that
  print a citation label are intercepted: \texttt{\string\cite},
  \texttt{\string\parencite}, and \texttt{\string\textcite}.

  \medskip
  The field extractors \texttt{\string\citeauthor},
  \texttt{\string\citeyear} and \texttt{\string\citetitle} print no
  label, so they leave the block alone; \texttt{\string\fsource}
  registers such keys manually.

  \medskip
  \parencite{mittelbach2004} extends the basics, while
  \textcite{knuth1984} coined the term. Proceedings with editors but no
  authors are handled too~\cite{nips2017}: the source line names the
  editor.
\end{frame}

\begin{frame}{What is \emph{not} intercepted}
  \texttt{\string\footcite} and \texttt{\string\footfullcite} already
  place the full citation in the footnote, so they are left alone --- an
  extra source line would only duplicate it.

  \medskip
  For comparison, here is a full footnote
  citation~\footfullcite{lamport1994}, with no additional source line
  below.

  \medskip
  The untouched originals are always available as
  \texttt{\string\ocite}, \texttt{\string\oparencite} and
  \texttt{\string\otextcite}:~\ocite{knuth1984} prints the style label
  and feeds nothing below --- with or without \texttt{patchcite}. Use
  them in frame titles and section headings, where a patched cite can
  misfire.
\end{frame}

\begin{frame}{Manual registration}
  \texttt{\string\fcite\,[pre]\{key\}[post]} prints the label and
  registers the source; the optional pre/post texts appear in the footer
  line only --- before the label and after the title.

  \medskip
  The idea goes back to~\fcite[cf.]{knuth1984}[ch.~2], and the standard
  reference is~\fcite{lamport1994}.\pause

  \medskip
  \texttt{\string\fsource} is the \emph{blind} variant: it registers the
  source without printing a marker.\fsource{mittelbach2004} Nothing
  visible here, yet the \LaTeX{} Companion appears below.
\end{frame}

\begin{frame}{Overlay behavior}
  A source is listed where the cite \emph{executes}, not where it becomes
  visible.
  \medskip
  \begin{itemize}
    \item \cite{knuth1984} sits in the open: listed on every slide.
    \item<2-> \only<2>{\fcite{lamport1994}} runs on slide~2 only, so Lamport
      appears from slide~2.
  \end{itemize}
  \medskip
  Uncover-style hiding (\texttt{\string\pause},
  \texttt{\string\onslide}, \texttt{\string\visible}) still typesets every
  pass; \texttt{\string\only} discards its content on other slides.
\end{frame}

\begin{frame}{Configuration}
  Three option groups, set at load time:
  \begin{description}
    \item[\texttt{patchcite}] intercept the standard cite commands
      (default). \texttt{nopatchcite} leaves them untouched; register
      sources with \texttt{\string\fcite} or \texttt{\string\fsource}.
    \item[\texttt{label=margin}] place the label in the left margin
      (default); \texttt{label=inline} sets label and title in one flow.
    \item[\texttt{rule=auto}] draw the footnote rule only when a real
      \texttt{\string\footnote} was called (default). \texttt{always}
      draws it for any footnote content; \texttt{never} suppresses it.
  \end{description}
  \medskip
  This demo loads \texttt{[rule=auto, label=margin]}.
\end{frame}

\begin{frame}{Known limitations}
  \begin{itemize}
    \item In \texttt{\string\frametitle}, \texttt{\string\framesubtitle},
      and section titles, cite with \texttt{\string\ocite}: titles
      expand late and theme-dependently, so a patched cite there can
      miss its slide, attach to the next frame, or work in one theme
      and fail in another. Add \texttt{\string\fsource} in the body
      if the source should still be listed.
    \item The source order is first appearance, not bibliography order.
    \item The multi-set commands \texttt{\string\cites},
      \texttt{\string\textcites}, \ldots\ and \texttt{\string\nocite} are
      not captured.
    \item In \texttt{rule=auto} mode, a \texttt{\string\footnote} inside a
      \texttt{minipage} (without the \texttt{[frame]} option) falsely
      draws the rule above the source block: the wrapper cannot tell a
      minipage-scoped footnote from a frame-scoped one (next slide).
  \end{itemize}
\end{frame}

\begin{frame}{Limitation: \texttt{rule=auto} and minipage footnotes}
  A \texttt{\string\footnote} inside a \texttt{minipage} (without the
  beamer \texttt{[frame]} option) is set at the minipage bottom --- standard
  beamer behavior, not a bug. The subtle part is the interaction with
  \texttt{rule=auto}: the rule above the source block should appear only
  when a real frame-level footnote sits above it. The package wraps
  \texttt{\string\footnote} to flag ``real footnote'', but cannot tell a
  minipage-scoped call from a frame-scoped one, so a minipage footnote
  still raises the flag.\vspace{2ex}

  \begin{minipage}{0.46\linewidth}
    A footnote inside a minipage.\footnote{Placed at the minipage bottom,
    yet it draws the rule above the source lines.}
  \end{minipage}\hfill%
  \begin{minipage}{0.46\linewidth}
    The cite here registers normally~\cite{mittelbach2004}, and a rule
    appears above it though no frame footnote is present.
  \end{minipage}\vspace{2ex}

  Workaround: \texttt{\string\footnote[frame]\{...\}} for a genuine frame
  footnote, or \texttt{rule=never} / \texttt{rule=always}.
\end{frame}

\begin{frame}[allowframebreaks]{References}
  \printbibliography
\end{frame}

\end{document}
