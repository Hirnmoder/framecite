% \section{Implementation}
%
% The implementation order follows the file: options, guards, the
% per-frame collection, the rendering commands, the frame-end flush,
% the cite-command interception, and the styling hooks.
%
% The package needs e-TeX (\textsf{etoolbox} keys off it), the beamer
% class (we patch \texttt{\string\endbeamer@frameslide} and hook the
% \texttt{frame} environment), and \textsf{biblatex} (\texttt{\string\DeclareCiteCommand}).
%
%    \begin{macrocode}
%<*package>
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{framecite}[2026/11/20 v0.8 Beamer per-frame mini references]
%    \end{macrocode}

%
% First the options. \texttt{patchcite}/\texttt{nopatchcite} select
% whether the cite commands are wrapped at all.
%
%    \begin{macrocode}
\newif\ifframecite@patchcite
\framecite@patchcitetrue
\DeclareOption{patchcite}{\framecite@patchcitetrue}
\DeclareOption{nopatchcite}{\framecite@patchcitefalse}
%    \end{macrocode}
%
% The label placement modes. The public option is
% \texttt{label=margin/inline}; internally the mode lives in the
% \cs{ifframecite@hang} flag: \texttt{margin} means the label is hung
% into the margin (hanging label), \texttt{inline} means label and title
% flow in one line.
%
%    \begin{macrocode}
\newif\ifframecite@hang
\framecite@hangtrue
\DeclareOption{label=margin}{\framecite@hangtrue}
\DeclareOption{label=inline}{\framecite@hangfalse}
%    \end{macrocode}
%
% The rule visibility mode. The chosen mode string is stored verbatim and
% compared later against the three saved literals with \cs{ifx}.
%
%    \begin{macrocode}
\def\framecite@rulemode{auto}
\def\framecite@rule@always{always}%
\def\framecite@rule@auto{auto}%
\def\framecite@rule@never{never}%
\DeclareOption{rule=always}{\def\framecite@rulemode{always}}
\DeclareOption{rule=auto}{\def\framecite@rulemode{auto}}
\DeclareOption{rule=never}{\def\framecite@rulemode{never}}
\DeclareOption*{\PackageWarning{framecite}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax
%    \end{macrocode}

%
% \textsf{etoolbox} drives the option handling below (lists, csname
% tools, patching). beamer must already be the document class: we patch
% \texttt{\string\endbeamer@frameslide} and hook
% \texttt{\string\AtBeginEnvironment\{frame\}}.
%
%    \begin{macrocode}
\RequirePackage{etoolbox}
%    \end{macrocode}

%
% Guard: the beamer class.
%
%    \begin{macrocode}
\@ifclassloaded{beamer}{}%
  {\PackageError{framecite}{Load framecite only under the beamer class.}%
   {Use \string\documentclass{beamer}\space BEFORE framecite.}}
%    \end{macrocode}

%
% Guard: \textsf{biblatex} must precede this package, because we wrap
% its cite commands and call \texttt{\string\DeclareCiteCommand}.
%
%    \begin{macrocode}
\@ifpackageloaded{biblatex}%
  {}%
  {\PackageError{framecite}{Load biblatex BEFORE framecite.}%
   {E.g. \string\usepackage[style=numeric]{biblatex}\space
    \string\addbibresource{refs.bib}\space\string\usepackage{framecite}}}
%    \end{macrocode}

%
%    \begin{macrocode}
\RequirePackage{xspace}% \xspace
%    \end{macrocode}

%
% The heart of the per-frame bookkeeping is a \emph{generation
% counter}. It bumps at every frame start; the seen flag
% \cs{framecite@seen@<gen>@<key>} dedups within one frame.
%
% \emph{Invariant: all state writes in this package are global}
% (\texttt{\string\csgdef}, \texttt{\string\xdef},
% \texttt{\string\g@addto@macro}). beamer typesets a frame once per
% overlay slide, with the body inside the frame's \texttt{vbox} group:
% group-local writes die at the end of each pass, so every bookkeeping
% write must survive the group.
%
% \cs{ifframecite@realfootnote} is raised by the \texttt{\string\footnote}
% wrapper in \texttt{auto} mode and gates the footnote rule. The flush
% writes \texttt{\string\footnotetext} directly, bypassing that wrapper,
% so source lines never count as real footnotes.
%
%    \begin{macrocode}
\newif\ifframecite@realfootnote
\newcommand*{\framecite@framekeys}{}
\gdef\framecite@framekeys{}
\gdef\framecite@gen{0}%
\AtBeginEnvironment{frame}{\gdef\framecite@framekeys{}%
  \global\framecite@realfootnotefalse
  \xdef\framecite@gen{\the\numexpr\framecite@gen+1\relax}}%
%    \end{macrocode}

%
% Registering is a two-step affair: split a key list, then record each
% unseen key.
%
%    \begin{macrocode}
\newcommand*{\framecite@addkeys}[1]{\forcsvlist\framecite@addone{#1}}
%    \end{macrocode}
%
% \cs{framecite@framekeys} is a token list of \cs{framecite@emit}\marg{key}
% calls: a small \emph{program} list. \texttt{\string\g@addto@macro}
% appends without re-expanding the old list, and the flush later simply
% executes the whole macro. Deduplication stays in \cs{framecite@addone}.
%
%    \begin{macrocode}
\newcommand*{\framecite@addone}[1]{%
  \ifcsdef{framecite@seen@\framecite@gen @#1}{}%
    {\csgdef{framecite@seen@\framecite@gen @#1}{}%
     \g@addto@macro\framecite@framekeys{\framecite@emit{#1}}}%
}
%    \end{macrocode}
%
% The pre/post texts. \cs{framecite@addprepost} receives the star flag,
% the key list, and the two optional texts; each key of the list is
% processed by \cs{framecite@addonepp}, with the arguments baked in via
% the partial-application form of \texttt{\string\forcsvlist}.
%
% Starred calls store the texts verbatim; missing texts are stored
% empty. Unstarred calls wrap \emph{pre} as \texttt{<pre>\string\xspace}
% and \emph{post} as \texttt{\string\xspace<post>}, and touch nothing
% when the argument is missing. The storage key is generation-stamped,
% so pre/post state is per frame like the key list. Note that unlike the
% list, the texts are not deduplicated: the last registration for a key
% on a frame wins.
%
%    \begin{macrocode}
\NewDocumentCommand{\framecite@addprepost}{m m m m}{\forcsvlist{\framecite@addonepp{#1}{#3}{#4}}{#2}}
\NewDocumentCommand{\framecite@addonepp}{m m m m}{%
  \IfBooleanTF{#1}{% star
    \IfValueTF{#2}{\csgdef{framecite@pre@\framecite@gen @#4}{#2}}{\csgdef{framecite@pre@\framecite@gen @#4}{}}%
    \IfValueTF{#3}{\csgdef{framecite@post@\framecite@gen @#4}{#3}}{\csgdef{framecite@post@\framecite@gen @#4}{}}%
  }{% no star
    \IfValueTF{#2}{\csgdef{framecite@pre@\framecite@gen @#4}{#2\xspace}}{}%
    \IfValueTF{#3}{\csgdef{framecite@post@\framecite@gen @#4}{\xspace#3}}{}%
  }%
}
%    \end{macrocode}

%
% Rendering: \cs{framecite@namesprefix} prints the author names (or, if
% there is no author, the editor names) with a trailing colon and tie;
% an entry with neither name prints nothing, so the entry falls back to
% the bare quoted title and no stray colon remains.
%
%    \begin{macrocode}
\newcommand*{\framecite@namesprefix}{%
  \ifnameundef{author}%
    {\ifnameundef{editor}{}{\printnames[][1-]{editor}:~}}%
    {\printnames[][1-]{author}:~}}
\DeclareCiteCommand{\framecite@cite}
  {}
  {\framecite@namesprefix\mkbibquote{\iffieldundef{shorttitle}{\printfield{title}}{\printfield{shorttitle}}}}
  {}
  {}
%    \end{macrocode}

%
% One entry, two shapes, selected by the placement mode.
%
%    \begin{macrocode}
\newcommand*{\framecite@entrytext}[1]{%
  \ifframecite@hang
%    \end{macrocode}
%
% In \texttt{margin} mode the pre text (if any), the label, and a small
% gap are pushed left into the margin with \texttt{\string\llap}. The
% title stays flush at the left edge like a normal footnote; the total
% width of the \texttt{\string\llap} box is zero, its content juts
% leftward into the gutter, and \texttt{\string\enspace} is the gap.
%
%    \begin{macrocode}
    \llap{\csuse{framecite@pre@\framecite@gen @#1}\framecite@orig@cite{#1}\enspace}%
    \framecite@cite{#1}\csuse{framecite@post@\framecite@gen @#1}%
  \else
    \csuse{framecite@pre@\framecite@gen @#1}\framecite@orig@cite{#1}\enspace\framecite@cite{#1}\csuse{framecite@post@\framecite@gen @#1}%
  \fi
}
%    \end{macrocode}

%
% \DescribeMacro{\fcite}
% prints the style-correct label in the text and delegates the
% registration to \cs{fsource}; the star is passed through, so the
% starred form stores the texts verbatim.
%
%    \begin{macrocode}
\NewDocumentCommand{\fcite}{s o m !o}{%
  \framecite@orig@cite{#3}%
  \IfBooleanTF{#1}{\fsource*[#2]{#3}[#4]}{\fsource[#2]{#3}[#4]}%
}
%    \end{macrocode}

%
% \DescribeMacro{\fsource}
% registers the key and the texts but typesets nothing itself.
% \texttt{\string\@bsphack}/\texttt{\string\@esphack} swallow the
% surrounding space, so no spurious white remains wherever it is used.
%
%    \begin{macrocode}
\NewDocumentCommand{\fsource}{s o m !o}{\@bsphack\framecite@addkeys{#3}\framecite@addprepost{#1}{#3}{#2}{#4}\@esphack}
%    \end{macrocode}

%
% The flush runs at the end of \texttt{\string\endbeamer@frameslide},
% that is, after the body but before the footnote output. Real
% \texttt{\string\footnote}s therefore land above the flushed source
% lines. (beamer ignores \texttt{\string\AtEndEnvironment} here, hence
% the patch made below.) In a \texttt{.sty} file \texttt{@} is already a
% letter, so no \texttt{\string\makeatletter} is needed.
%
%    \begin{macrocode}
\newcommand*{\framecite@flush}{%
  \ifx\framecite@framekeys\@empty\else
    \begingroup
      \renewcommand{\@makefnmark}{}% blank mark: the source line itself carries the cite label
%    \end{macrocode}
%
% The key list is executed directly. \cs{framecite@emit} is bound here,
% locally, so every stored \cs{framecite@emit}\marg{key} emits one
% \texttt{\string\footnotetext} with the framecite font and color and a
% tighter line spread for the tiny source lines.
%
%    \begin{macrocode}
      \def\framecite@emit##1{\footnotetext{\usebeamerfont{framecite}\usebeamercolor[fg]{framecite}%
          \linespread{0}\selectfont% tighter line spacing for the tiny source lines
          \raggedright\framecite@entrytext{##1}}}%
      \framecite@framekeys% executes \framecite@emit{k1}\framecite@emit{k2}\ldots
    \endgroup
  \fi
}
%    \end{macrocode}

%
% The interception itself. For each command we save the current meaning
% under \texttt{\string\framecite@orig@<cmd>} with \texttt{\string\csletcs}
% (a plain \texttt{\string\let} cannot handle csnames built at runtime),
% then redefine the public command with an initial \texttt{\string\expandafter}
% so that \texttt{\string\RenewDocumentCommand} sees the resolved csname.
% The wrapper spec \texttt{s o o m} parses star and both optional
% arguments, forwards every combination to the saved original, and
% registers the keys along the way; starred variants keep their star.
%
%    \begin{macrocode}
\newcommand*{\framecite@patch}[1]{%
  \@ifundefined{#1}%
    {\PackageWarning{framecite}{Cannot patch \string#1: not defined.}}%
    {\csletcs{framecite@orig@#1}{#1}%
     \expandafter\RenewDocumentCommand\csname #1\endcsname{s o o m}{%
       \framecite@addkeys{##4}%
       \IfBooleanTF{##1}%
         {\IfValueTF{##2}%
            {\IfValueTF{##3}%
               {\csname framecite@orig@#1\endcsname*[##2][##3]{##4}}%
               {\csname framecite@orig@#1\endcsname*[##2]{##4}}}%
            {\csname framecite@orig@#1\endcsname*{##4}}}%
         {\IfValueTF{##2}%
            {\IfValueTF{##3}%
               {\csname framecite@orig@#1\endcsname[##2][##3]{##4}}%
               {\csname framecite@orig@#1\endcsname[##2]{##4}}}%
            {\csname framecite@orig@#1\endcsname{##4}}}}}%
}
%    \end{macrocode}

%
% At \texttt{\string\AtBeginDocument} three things happen.
%
% First, the original \texttt{\string\cite} is saved unconditionally:
% \cs{fcite} prints it, the flush renders the labels with it, and
% neither may recurse into the wrapped \texttt{\string\cite}. For each
% wrappable command, \cs{ocite}, \cs{oparencite}, and \cs{otextcite}
% snapshot the untouched original here, before the patch list runs.
% This works whether or not \texttt{patchcite} is on. Second, the
% frame-end hook is
% installed: one \texttt{\string\patchcmd} call adds the flush after the
% \cs{par} that closes the body of
% \texttt{\string\endbeamer@frameslide}.
%
%    \begin{macrocode}
\AtBeginDocument{%
  \csletcs{framecite@orig@cite}{cite}%
  \csletcs{ocite}{cite}%
  \csletcs{oparencite}{parencite}%
  \csletcs{otextcite}{textcite}%
  \patchcmd{\endbeamer@frameslide}{\par}{\par\framecite@flush}{}%
    {\PackageWarning{framecite}{Could not patch \string\endbeamer@frameslide}}%
%    \end{macrocode}
%
% Third, the patch list: only \texttt{\string\cite},
% \texttt{\string\parencite}, and \texttt{\string\textcite} are
% wrapped --- the short-form commands that print a citation label. The
% field extractors \texttt{\string\citeauthor},
% \texttt{\string\citeyear}, and \texttt{\string\citetitle} print no
% label, so they leave the source block alone.
% \texttt{\string\footcite} and \texttt{\string\footcitetext} are out
% as well: they already place the full citation in the footnote.
% \cs{fsource} feeds any of these keys manually if ever wanted.
%
%    \begin{macrocode}
  \ifframecite@patchcite
    \framecite@patch{cite}\framecite@patch{parencite}\framecite@patch{textcite}%
  \fi
%    \end{macrocode}
%
% The rule modes. beamer draws \texttt{\string\footnoterule} once per
% frame (in \texttt{\string\beamer@autobreakframebox}) when the footnote
% insert is non-empty. We keep a copy of the original and redefine the
% rule per mode: \texttt{never} drops it, \texttt{auto} draws it only
% when the real-footnote flag is up, \texttt{always} leaves beamer's
% default intact.
%
%    \begin{macrocode}
  \let\framecite@orig@footnoterule\footnoterule
  \ifx\framecite@rulemode\framecite@rule@never
    \renewcommand{\footnoterule}{}%
  \else\ifx\framecite@rulemode\framecite@rule@auto
    \renewcommand{\footnoterule}{\ifframecite@realfootnote\framecite@orig@footnoterule\fi}%
  \else % always: leave beamer's default \footnoterule intact
  \fi\fi
%    \end{macrocode}
%
% In \texttt{auto} mode we wrap \texttt{\string\footnote} so that real
% footnotes raise the rule flag. The wrapper parses the optional
% \texttt{<overlay>} with \texttt{\string\@ifnextchar} and forwards
% everything to the saved original; calling the saved token avoids
% recursion. The flag assignment is deliberately global, because
% \texttt{\string\footnoterule} runs later inside the output routine.
%
%    \begin{macrocode}
  \ifx\framecite@rulemode\framecite@rule@auto
    \csletcs{framecite@orig@footnote}{footnote}%
    \def\footnote{\@ifnextchar<\framecite@footnote@ov\framecite@footnote@noov}%
    \def\framecite@footnote@ov<#1>{\global\framecite@realfootnotetrue\framecite@orig@footnote<#1>}%
    \def\framecite@footnote@noov{\global\framecite@realfootnotetrue\framecite@orig@footnote}%
  \fi
}
%    \end{macrocode}

%
% Finally the styling: the beamer element \texttt{framecite} controls
% font and color of the source lines only, never of real footnotes.
%
%    \begin{macrocode}
\setbeamercolor{framecite}{fg=normal text.fg!70}
\setbeamerfont{framecite}{size=\tiny}

\endinput
%</package>
%    \end{macrocode}
%
% \Finale
